      "cmd": {
        "type": "generate_town",
        "w": 64,
        "h": 48,
        "water": 18,
        "residents": 14,
        "tone": "standard"
      }
    },
    {
      "op": "soak",
      "days": 14,
      "shadow_threads": 3,
      "max_growth_permille": 3000,
      "plateau_permille": 300,
      "max_memories_per_pawn": 200,
      "max_journal_entries": 120
    },
    {
      "op": "expect",
      "day": 14,
      "pawns": 14,
      "relationships_min": 30,
      "memories_min": 150,
      "remembered_talks_min": 100,
      "journal_min": 10
    },
    {
      "op": "reload",
